"""
Pivot High/Low (LuxAlgo-style) Backtest - ALL TIMEFRAMES in ONE run

Stop-and-reverse:
confirmed pivot LOW -> LONG
confirmed pivot HIGH -> SHORT

POSITION MANAGEMENT:
- 75% position: fixed TP at +2% price move
- Remaining 25%: runner
- Once 75% TP is hit, SL for remaining 25% moves to BREAKEVEN
- Remaining 25% closes at:
    1. Breakeven, OR
    2. Liquidation, OR
    3. Pivot reversal / opposite signal
- Entry = close of the bar where pivot is confirmed (no look-ahead)

Rs 1000 margin per trade with LEVERAGE (default 10x)
Position = Rs 10,000

Outputs:
backtest_all_trades.csv
backtest_summary.csv
equity_all.png
"""

import argparse
import os
import time
import numpy as np
import pandas as pd


# =========================================================
# DEFAULT CONFIGURATION
# =========================================================

MARGIN = 1000.0
LEV = 10
MMR = 0.005

# Fee = 0.10% per side on full position size
FEE_PCT = 0.10

# Optional liquidation protection
SL = 0.0

# =========================================================
# NEW TP / PARTIAL EXIT SETTINGS
# =========================================================

TP_PCT = 2.0

TP_PART = 0.75       # 75% fixed TP
RUNNER_PART = 0.25   # 25% runner

# After 75% TP is hit:
# runner SL = entry price
BREAKEVEN_AFTER_TP = True


TFS = ["5m", "15m", "30m", "1h", "4h"]


EXCHANGES = {
    "LAST_PRICE": [
        "binanceus",
        "gateio",
        "mexc",
        "kucoin",
        "bitget",
        "okx",
        "bybit"
    ],

    "MARK_PRICE": [
        "gateio",
        "bitget",
        "okx",
        "bybit",
        "binanceusdm",
        "kucoinfutures"
    ],

    "INDEX_PRICE": [
        "gateio",
        "bitget",
        "okx",
        "bybit",
        "binanceusdm"
    ],
}


# =========================================================
# NORMALIZE PAIR
# =========================================================

def norm_pair(p):

    p = p.upper().replace("-", "/").replace("_", "/")

    if "/" not in p:
        for q in ("USDT", "USDC", "USD"):

            if p.endswith(q):
                return p[: -len(q)] + "/" + q

    return p


# =========================================================
# FETCH DATA
# =========================================================

def fetch(pair, tf, days, warmup, price, first=""):

    import ccxt

    errs = []

    order = (
        [first] if first else []
    ) + [
        e for e in EXCHANGES[price]
        if e != first
    ]

    for name in order:

        try:

            ex = getattr(ccxt, name)(
                {"enableRateLimit": True}
            )

            ex.load_markets()

            sym = (
                pair
                if price == "LAST_PRICE"
                else pair + ":" + pair.split("/")[1]
            )

            if sym not in ex.markets:
                raise ValueError(
                    f"{sym} not listed"
                )

            fn = {
                "LAST_PRICE": ex.fetch_ohlcv,
                "MARK_PRICE": ex.fetch_mark_ohlcv,
                "INDEX_PRICE": ex.fetch_index_ohlcv
            }[price]

            tf_ms = ex.parse_timeframe(tf) * 1000

            now = ex.milliseconds()

            since = (
                now
                - days * 86400000
                - warmup * tf_ms
            )

            rows = []

            while since < now:

                b = fn(
                    sym,
                    tf,
                    since=since,
                    limit=1000
                )

                if not b:
                    break

                rows += b

                nxt = b[-1][0] + tf_ms

                if nxt <= since:
                    break

                since = nxt

                time.sleep(
                    ex.rateLimit / 1000
                )

            if len(rows) < 2 * warmup:

                raise ValueError(
                    f"only {len(rows)} candles"
                )

            df = pd.DataFrame(rows).iloc[:, :5]

            df.columns = [
                "time",
                "open",
                "high",
                "low",
                "close"
            ]

            df["time"] = pd.to_datetime(
                df["time"],
                unit="ms"
            )

            print(
                f"[{tf}] data: {name} "
                f"{sym} {price} "
                f"({len(df)} candles)"
            )

            return (
                df
                .drop_duplicates("time")
                .sort_values("time")
                .reset_index(drop=True)
            )

        except Exception as e:

            errs.append(
                f"{name}: {str(e)[:60]}"
            )

    raise RuntimeError(
        " | ".join(errs)
    )


# =========================================================
# BACKTEST
# =========================================================

def backtest(df, length, days, tf):

    high = df["high"].values
    low = df["low"].values
    close = df["close"].values
    t = df["time"]

    cutoff = (
        t.iloc[-1]
        - pd.Timedelta(days=days)
    )

    trades = []

    # -----------------------------------------------------
    # POSITION VARIABLES
    # -----------------------------------------------------

    pos = 0

    epx = None
    et = None

    # Full position notional
    notional = MARGIN * LEV

    # Partial position notionals
    tp_notional = notional * TP_PART
    runner_notional = notional * RUNNER_PART

    # TP distance
    tp_distance = TP_PCT / 100

    # Liquidation distance
    liq = max(
        1 / LEV - MMR,
        0.001
    )

    # Optional SL
    sd = (
        SL / 100
        if 0 < SL / 100 < liq
        else None
    )

    # -----------------------------------------------------
    # PARTIAL POSITION STATE
    # -----------------------------------------------------

    tp_hit = False
    runner_active = False

    # -----------------------------------------------------
    # CLOSE 75% TP
    # -----------------------------------------------------

    def close_tp(px, tm):

        nonlocal tp_hit

        # Profit on 75%
        if pos == 1:
            g = tp_notional * (
                px / epx - 1
            )
        else:
            g = tp_notional * (
                epx / px - 1
            )

        # Entry + exit fee for 75%
        fee = (
            tp_notional
            * FEE_PCT / 100
            * 2
        )

        net = g - fee

        trades.append(
            dict(
                tf=tf,
                side=(
                    "LONG"
                    if pos == 1
                    else "SHORT"
                ),
                entry_time=et,
                entry_price=epx,
                exit_time=tm,
                exit_price=px,
                portion="75%",
                gross_pnl=round(g, 2),
                fees=round(fee, 2),
                net_pnl=round(net, 2),
                status="TP 2%"
            )
        )

        tp_hit = True

    # -----------------------------------------------------
    # CLOSE REMAINING 25%
    # -----------------------------------------------------

    def close_runner(px, tm, status):

        if pos == 1:

            g = runner_notional * (
                px / epx - 1
            )

        else:

            g = runner_notional * (
                epx / px - 1
            )

        fee = (
            runner_notional
            * FEE_PCT / 100
            * 2
        )

        net = g - fee

        if status == "LIQUIDATED":

            net = -runner_notional

        trades.append(
            dict(
                tf=tf,
                side=(
                    "LONG"
                    if pos == 1
                    else "SHORT"
                ),
                entry_time=et,
                entry_price=epx,
                exit_time=tm,
                exit_price=px,
                portion="25%",
                gross_pnl=round(g, 2),
                fees=round(fee, 2),
                net_pnl=round(net, 2),
                status=status
            )
        )

    # -----------------------------------------------------
    # MAIN LOOP
    # -----------------------------------------------------

    for i in range(
        2 * length,
        len(df)
    ):

        # =================================================
        # MANAGE EXISTING POSITION
        # =================================================

        if pos:

            # ---------------------------------------------
            # 1. CHECK 75% TP
            # ---------------------------------------------

            if not tp_hit:

                if pos == 1:

                    tp_price = (
                        epx
                        * (1 + tp_distance)
                    )

                    tp_reached = (
                        high[i] >= tp_price
                    )

                else:

                    tp_price = (
                        epx
                        * (1 - tp_distance)
                    )

                    tp_reached = (
                        low[i] <= tp_price
                    )

                if tp_reached:

                    # Close exactly 75% at TP
                    close_tp(
                        tp_price,
                        t.iloc[i]
                    )

                    runner_active = True

            # ---------------------------------------------
            # 2. RUNNER / 25% MANAGEMENT
            # ---------------------------------------------

            if tp_hit:

                # After TP, runner SL is breakeven
                if BREAKEVEN_AFTER_TP:

                    if pos == 1:

                        if low[i] <= epx:

                            close_runner(
                                epx,
                                t.iloc[i],
                                "BREAKEVEN"
                            )

                            pos = 0
                            epx = None
                            et = None
                            tp_hit = False
                            runner_active = False

                            # Continue to next candle
                            continue

                    else:

                        if high[i] >= epx:

                            close_runner(
                                epx,
                                t.iloc[i],
                                "BREAKEVEN"
                            )

                            pos = 0
                            epx = None
                            et = None
                            tp_hit = False
                            runner_active = False

                            continue

            # ---------------------------------------------
            # 3. OPTIONAL ORIGINAL SL
            # ---------------------------------------------

            if pos and sd and not tp_hit:

                adv = (
                    (epx - low[i]) / epx
                    if pos == 1
                    else
                    (high[i] - epx) / epx
                )

                if adv >= sd:

                    stop_px = (
                        epx * (1 - sd)
                        if pos == 1
                        else epx * (1 + sd)
                    )

                    # Before TP: full position
                    # gets stopped
                    g = (
                        notional
                        * pos
                        * (stop_px / epx - 1)
                    )

                    fee = (
                        notional
                        * FEE_PCT / 100
                        * 2
                    )

                    net = max(
                        g - fee,
                        -MARGIN
                    )

                    trades.append(
                        dict(
                            tf=tf,
                            side=(
                                "LONG"
                                if pos == 1
                                else "SHORT"
                            ),
                            entry_time=et,
                            entry_price=epx,
                            exit_time=t.iloc[i],
                            exit_price=stop_px,
                            portion="100%",
                            gross_pnl=round(
                                max(g, -MARGIN),
                                2
                            ),
                            fees=round(
                                fee,
                                2
                            ),
                            net_pnl=round(
                                net,
                                2
                            ),
                            status="STOP LOSS"
                        )
                    )

                    pos = 0
                    epx = None
                    et = None
                    tp_hit = False
                    runner_active = False

                    continue

            # ---------------------------------------------
            # 4. LIQUIDATION
            # ---------------------------------------------

            if pos:

                adv = (
                    (epx - low[i]) / epx
                    if pos == 1
                    else
                    (high[i] - epx) / epx
                )

                if adv >= liq:

                    liq_px = (
                        epx * (1 - liq)
                        if pos == 1
                        else epx * (1 + liq)
                    )

                    if tp_hit:

                        # Only 25% remains
                        close_runner(
                            liq_px,
                            t.iloc[i],
                            "LIQUIDATED"
                        )

                    else:

                        # Full position liquidated
                        fee = (
                            notional
                            * FEE_PCT / 100
                            * 2
                        )

                        trades.append(
                            dict(
                                tf=tf,
                                side=(
                                    "LONG"
                                    if pos == 1
                                    else "SHORT"
                                ),
                                entry_time=et,
                                entry_price=epx,
                                exit_time=t.iloc[i],
                                exit_price=liq_px,
                                portion="100%",
                                gross_pnl=-MARGIN,
                                fees=round(
                                    fee,
                                    2
                                ),
                                net_pnl=-MARGIN,
                                status="LIQUIDATED"
                            )
                        )

                    pos = 0
                    epx = None
                    et = None
                    tp_hit = False
                    runner_active = False

                    continue

        # =================================================
        # PIVOT DETECTION
        # =================================================

        c = i - length

        wh = high[
            c - length:i + 1
        ]

        wl = low[
            c - length:i + 1
        ]

        ph = (
            high[c] == wh.max()
            and
            (wh == high[c]).sum() == 1
        )

        pl = (
            low[c] == wl.min()
            and
            (wl == low[c]).sum() == 1
        )

        if not (ph or pl):
            continue

        if t.iloc[i] < cutoff:
            continue

        # Count pivot
        d = -1 if ph else 1

        # Same direction -> ignore
        if d == pos:
            continue

        # =================================================
        # OPPOSITE SIGNAL
        # =================================================

        if pos:

            # Close whatever remains
            if tp_hit:

                close_runner(
                    close[i],
                    t.iloc[i],
                    "closed"
                )

            else:

                # Full position still active
                g = (
                    notional
                    * pos
                    * (close[i] / epx - 1)
                )

                fee = (
                    notional
                    * FEE_PCT / 100
                    * 2
                )

                net = max(
                    g - fee,
                    -MARGIN
                )

                trades.append(
                    dict(
                        tf=tf,
                        side=(
                            "LONG"
                            if pos == 1
                            else "SHORT"
                        ),
                        entry_time=et,
                        entry_price=epx,
                        exit_time=t.iloc[i],
                        exit_price=close[i],
                        portion="100%",
                        gross_pnl=round(
                            max(g, -MARGIN),
                            2
                        ),
                        fees=round(
                            fee,
                            2
                        ),
                        net_pnl=round(
                            net,
                            2
                        ),
                        status="closed"
                    )
                )

        # =================================================
        # NEW POSITION
        # =================================================

        pos = d
        epx = close[i]
        et = t.iloc[i]

        tp_hit = False
        runner_active = False

    # =====================================================
    # CLOSE OPEN POSITION AT END
    # =====================================================

    if pos:

        if tp_hit:

            close_runner(
                close[-1],
                t.iloc[-1],
                "open (MTM)"
            )

        else:

            g = (
                notional
                * pos
                * (close[-1] / epx - 1)
            )

            fee = (
                notional
                * FEE_PCT / 100
                * 2
            )

            net = max(
                g - fee,
                -MARGIN
            )

            trades.append(
                dict(
                    tf=tf,
                    side=(
                        "LONG"
                        if pos == 1
                        else "SHORT"
                    ),
                    entry_time=et,
                    entry_price=epx,
                    exit_time=t.iloc[-1],
                    exit_price=close[-1],
                    portion="100%",
                    gross_pnl=round(
                        max(g, -MARGIN),
                        2
                    ),
                    fees=round(
                        fee,
                        2
                    ),
                    net_pnl=round(
                        net,
                        2
                    ),
                    status="open (MTM)"
                )
            )

    return pd.DataFrame(trades), npv


# =========================================================
# SUMMARY
# =========================================================

def summarize(tf, tr, npv, err=""):

    s = dict(
        tf=tf,
        pivots=npv,
        trades=0,
        long=0,
        short=0,
        wins=0,
        win_pct=0.0,
        net_pnl=0.0,
        realised=0.0,
        open_mtm=0.0,
        liq=0,
        sl_hits=0,
        tp_hits=0,
        breakeven=0,
        fees=0.0,
        profit_factor=0.0,
        max_dd=0.0,
        note=err
    )

    if tr.empty:
        return s

    w = tr[
        tr.net_pnl > 0
    ]

    l = tr[
        tr.net_pnl <= 0
    ]

    eq = pd.concat(
        [
            pd.Series([0.0]),
            tr.net_pnl.cumsum()
        ],
        ignore_index=True
    )

    gl = abs(
        l.net_pnl.sum()
    )

    s.update(

        trades=len(tr),

        long=int(
            (tr.side == "LONG").sum()
        ),

        short=int(
            (tr.side == "SHORT").sum()
        ),

        wins=len(w),

        win_pct=round(
            len(w) / len(tr) * 100,
            1
        ),

        net_pnl=round(
            tr.net_pnl.sum(),
            2
        ),

        realised=round(
            tr[
                tr.status != "open (MTM)"
            ].net_pnl.sum(),
            2
        ),

        open_mtm=round(
            tr[
                tr.status == "open (MTM)"
            ].net_pnl.sum(),
            2
        ),

        liq=int(
            (
                tr.status ==
                "LIQUIDATED"
            ).sum()
        ),

        sl_hits=int(
            (
                tr.status ==
                "STOP LOSS"
            ).sum()
        ),

        tp_hits=int(
            (
                tr.status ==
                "TP 2%"
            ).sum()
        ),

        breakeven=int(
            (
                tr.status ==
                "BREAKEVEN"
            ).sum()
        ),

        fees=round(
            tr.fees.sum(),
            2
        ),

        profit_factor=round(
            w.net_pnl.sum() / gl,
            2
        ) if gl else float("inf"),

        max_dd=round(
            (
                eq - eq.cummax()
            ).min(),
            2
        )
    )

    return s


# =========================================================
# EQUITY PLOT
# =========================================================

def plot_all(all_tr, path):

    try:

        import matplotlib

        matplotlib.use("Agg")

        import matplotlib.pyplot as plt

    except ImportError:

        return

    fig, ax = plt.subplots(
        figsize=(10, 5)
    )

    for tf, g in all_tr.groupby(
        "tf",
        sort=False
    ):

        ax.step(
            g.exit_time,
            g.net_pnl.cumsum(),
            where="post",
            marker="o",
            label=tf
        )

    ax.axhline(
        0,
        color="gray",
        lw=0.8
    )

    ax.set_title(
        "Equity curves - all timeframes "
        "(Rs, net of fees)"
    )

    ax.legend()

    fig.autofmt_xdate()

    fig.tight_layout()

    fig.savefig(
        path,
        dpi=120
    )


# =========================================================
# GITHUB SUMMARY
# =========================================================

def gh_summary(sm, args, pair):

    path = os.environ.get(
        "GITHUB_STEP_SUMMARY"
    )

    if not path:
        return

    with open(path, "a") as f:

        f.write(
            f"## Pivot Backtest | "
            f"{pair} | "
            f"{args.price} | "
            f"last {args.days} days | "
            f"length {args.length} | "
            f"{LEV:g}x | "
            f"75% TP {TP_PCT:g}% | "
            f"25% BE runner\n\n"
        )

        f.write(
            "| TF | Trades | Win% | Net P&L | "
            "Realised | Open MTM | TP Hits | "
            "BE | Liquidated | SL hits | Fees | PF | Max DD |\n"
        )

        f.write(
            "|---|---|---|---|---|---|---|---|---|---|---|---|---|\n"
        )

        for r in sm.itertuples():

            f.write(
                f"| {r.tf} | "
                f"{r.trades} | "
                f"{r.win_pct}% | "
                f"{r.net_pnl} | "
                f"{r.realised} | "
                f"{r.open_mtm} | "
                f"{r.tp_hits} | "
                f"{r.breakeven} | "
                f"{r.liq} | "
                f"{r.sl_hits} | "
                f"{r.fees} | "
                f"{r.profit_factor} | "
                f"{r.max_dd} |"
                f"{' ' + r.note if r.note else ''}\n"
            )

        f.write(
            f"\nMargin Rs {MARGIN:.0f} x "
            f"{LEV}x = Rs "
            f"{MARGIN * LEV:.0f} position. "
            f"75% fixed TP at +{TP_PCT:g}%, "
            f"25% runner moves to breakeven "
            f"after TP. Fee {FEE_PCT}%/side. "
            "Funding & slippage ignored.\n"
        )


# =========================================================
# MAIN
# =========================================================

if __name__ == "__main__":

    ap = argparse.ArgumentParser()

    ap.add_argument(
        "--pair",
        default="BTCUSDT"
    )

    ap.add_argument(
        "--days",
        type=int,
        default=30
    )

    ap.add_argument(
        "--price",
        default="LAST_PRICE",
        choices=list(EXCHANGES)
    )

    ap.add_argument(
        "--length",
        type=int,
        default=50
    )

    ap.add_argument(
        "--tfs",
        default=",".join(TFS)
    )

    ap.add_argument(
        "--first",
        default="",
        help="preferred exchange tried first"
    )

    ap.add_argument(
        "--lev",
        type=float,
        default=10
    )

    ap.add_argument(
        "--margin",
        type=float,
        default=1000
    )

    ap.add_argument(
        "--sl",
        type=float,
        default=0,
        help="stop-loss %% of price, 0 = off"
    )

    a = ap.parse_args()

    LEV = a.lev
    MARGIN = a.margin
    SL = a.sl

    pair = norm_pair(
        a.pair
    )

    all_tr = []
    rows = []

    for tf in a.tfs.split(","):

        try:

            df = fetch(
                pair,
                tf,
                a.days,
                2 * a.length + 5,
                a.price,
                a.first.strip().lower()
            )

            tr, npv = backtest(
                df,
                a.length,
                a.days,
                tf
            )

            rows.append(
                summarize(
                    tf,
                    tr,
                    npv
                )
            )

            if not tr.empty:

                all_tr.append(tr)

        except Exception as e:

            print(
                f"[{tf}] ERROR: {e}"
            )

            rows.append(
                summarize(
                    tf,
                    pd.DataFrame(),
                    0,
                    "ERROR: "
                    + str(e)[:300]
                )
            )

    sm = pd.DataFrame(rows)

    print(
        "\n"
        + "=" * 100
    )

    print(
        f"{pair} | "
        f"{a.price} | "
        f"last {a.days}d | "
        f"length {a.length} | "
        f"margin Rs {MARGIN:.0f} x "
        f"{LEV:g}x | "
        f"75% TP {TP_PCT:g}% | "
        f"25% runner BE | "
        f"SL {SL:g}% | "
        f"fee {FEE_PCT}%/side"
    )

    print(
        "=" * 100
    )

    print(
        sm.drop(
            columns="note"
        ).to_string(
            index=False
        )
    )

    # -----------------------------------------------------
    # SUMMARY CSV
    # -----------------------------------------------------

    sm.to_csv(
        "backtest_summary.csv",
        index=False
    )

    # -----------------------------------------------------
    # ALL TRADES CSV
    # -----------------------------------------------------

    if all_tr:

        at = pd.concat(
            all_tr,
            ignore_index=True
        )

        at.to_csv(
            "backtest_all_trades.csv",
            index=False
        )

        print(
            "\nALL TRADES\n"
            + at.to_string(
                index=False
            )
        )

        plot_all(
            at,
            "equity_all.png"
        )

    # -----------------------------------------------------
    # GITHUB SUMMARY
    # -----------------------------------------------------

    gh_summary(
        sm,
        a,
        pair
    )