name: Pivot Backtest

on:
  workflow_dispatch:            # GitHub > Actions > Run workflow (manual)
    inputs:
      symbol:
        description: "Symbol (ccxt format)"
        default: "BTC/USDT"
      length:
        description: "Pivot length"
        default: "50"
      days:
        description: "Backtest days"
        default: "30"
  schedule:
    - cron: "30 2 * * *"        # roz subah 8:00 AM IST

jobs:
  backtest:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        tf: ["5m", "15m", "30m", "1h", "4h"]   # 5 timeframes
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: pip install pandas numpy ccxt matplotlib

      - name: Run backtest (${{ matrix.tf }})
        run: |
          python pivot_backtest.py \
            --exchange binanceus \
            --symbol "${{ github.event.inputs.symbol || 'BTC/USDT' }}" \
            --tf ${{ matrix.tf }} \
            --length ${{ github.event.inputs.length || '50' }} \
            --days ${{ github.event.inputs.days || '30' }}

      - name: Upload results
        uses: actions/upload-artifact@v4
        with:
          name: backtest-${{ matrix.tf }}
          path: |
            backtest_trades_*.csv
            equity_curve_*.png
